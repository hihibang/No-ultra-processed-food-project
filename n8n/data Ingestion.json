    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  const data = item.json.output || item.json;\n\n  const parseList = (val) => {\n    if (Array.isArray(val)) return val.join(', ');\n    if (typeof val === 'string') return val;\n    return '';\n  };\n\n  const mainIng = parseList(data.main_ingredients);\n  const subIng = parseList(data.sub_ingredients);\n  const stepsText = Array.isArray(data.steps_list) \n    ? data.steps_list.join('\\n') \n    : (data.steps || data.steps_list || '');\n\n  const pageContent = `\n요리명: ${data.recipe_title || ''}\n요리 유형: ${data.recipe_type || ''} (${data.cooking_method || ''})\n요약: ${data.recipe_summary || ''}\n주재료: ${mainIng}\n부재료: ${subIng}\n조리 순서:\n${stepsText}\n  `.trim();\n\n  return {\n    json: {\n      id: index, // Qdrant 고유 ID (0 ~ 1151)\n      pageContent: pageContent,\n      metadata: {\n        recipe_id: data.recipe_id,\n        recipe_title: data.recipe_title || '',\n        recipe_type: data.recipe_type || '',\n        cooking_method: data.cooking_method || '',\n        main_ingredients: mainIng,\n        sub_ingredients: subIng,\n        pageContent: pageContent\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
